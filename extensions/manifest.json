{
  "manifest_version": 3,
  "name": "Study Planner AI",
  "version": "1.0",
  "description": "AI Study Assistant — sidebar panel",

  "action": {
    "default_popup": "public/popup.html",
    "default_icon": {
      "16": "icons.svg",
      "48": "icons.svg",
      "128": "icons.svg"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["sidebar.css"],
      "run_at": "document_end"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["assets/*", "sidebar.html", "sidebar.css"],
      "matches": ["<all_urls>"]
    }
  ],

  "permissions": ["storage", "activeTab", "tabs"],

  "host_permissions": ["http://localhost:5000/*"]
}
